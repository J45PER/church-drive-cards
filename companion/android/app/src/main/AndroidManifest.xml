<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Cleartext allowed because Home Assistant is often reached over plain http on the LAN. -->
    <application
        android:allowBackup="false"
        android:label="Church Drive"
        android:theme="@style/Theme.ChurchDrive"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".widget.AlarmWidget"
            android:exported="false"
            android:label="Church Drive alarm">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_alarm" />
        </receiver>
        <receiver
            android:name=".widget.LightsWidget"
            android:exported="false"
            android:label="Church Drive lights">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_lights" />
        </receiver>
        <receiver
            android:name=".widget.ClimateWidget"
            android:exported="false"
            android:label="Church Drive climate">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_climate" />
        </receiver>
    </application>
</manifest>
