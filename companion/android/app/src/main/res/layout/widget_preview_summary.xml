<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/pv_card" android:gravity="center_vertical" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/pv_tile" android:orientation="vertical" android:padding="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20.5°" android:textColor="#FFFFAB70" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inside" android:textColor="#FFBDC1C6" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/pv_tile" android:orientation="vertical" android:padding="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="48%" android:textColor="#FF4DD0E1" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Humidity" android:textColor="#FFBDC1C6" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/pv_tile" android:orientation="vertical" android:padding="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="88" android:textColor="#FF81C995" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Air quality" android:textColor="#FFBDC1C6" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/pv_tile" android:orientation="vertical" android:padding="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Disarmed" android:textColor="#FF81C995" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alarm" android:textColor="#FFBDC1C6" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
