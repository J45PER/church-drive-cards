<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ChurchDrive" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <!-- The voice overlay: no window animation of its own, so the dimmed backdrop never slides with the card. -->
    <style name="Theme.Assist" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
