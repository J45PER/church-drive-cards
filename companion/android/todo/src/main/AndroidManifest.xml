<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The Church Drive app's sign-in. Only the phone app declares this permission: Google Play signs each app with its own key, and a second
         app declaring the same permission under a different key is refused at install ("Can't install"). Asking for it is harmless: it is
         granted only when both apps share a key (as builds from GitHub do); otherwise To-Do signs in for itself. -->
    <uses-permission android:name="com.churchdrive.app.permission.SHARE_SESSION" />
    <queries>
        <provider android:authorities="com.churchdrive.app.sessionshare" />
        <!-- To open the Church Drive app (its device pages, and its own page for the open task). -->
        <package android:name="com.churchdrive.manager" />
    </queries>

    <!-- Cleartext allowed because Home Assistant is often reached over plain http on the LAN. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Church Drive To Do"
        android:theme="@style/Theme.ChurchDriveTodo"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
