  "morph": {
    "from": "two squircles (Clive's mark as his thinking leaves it)",
    "note": "Every icon starts the same way: Clive's two squircles shrink into one while the hole between them shrinks to a dot. Then it goes to a container that suits the icon (circle, or a rounded rectangle for tall and wide shapes), grows to size, and the inner icon grows in together as one piece. The To-Do logo uses the app splash morph.",
    "ms": 1100,
    "recipe_fields": {
      "arc": "how far the squircles swing on a curve, as a fraction of the distance",
      "spin": "degrees the body turns as it settles",
      "d": "how small parts arrive: pop, drop, rise, left, right, spin",
      "ds": "spin of small parts, degrees",
      "o": "order small parts arrive: size, ltr, rtl, ttb, btt, radial",
      "ease": "back, out or inout",
      "swap": "swap which squircle becomes which body shape",
      "flow": "container the icon grows from: solid, disc, box, seed, direct (squircle straight to the shape, for shields), wipe (drawn on from a point), chain (pieces appear one after another), old",
      "body": "hub: the main shape is the small circle in the middle (fan)",
      "start": "{at:bottom, shape:circle|box, f} start from a base at the bottom (lock, spray bottle, thermometer)",
      "em": "where parts emerge from: centre, down, up, left, right, dropin, own, prev",
      "em2": "the same for the small parts",
      "step": "delay between parts, as a fraction of the morph",
      "wipe": "x+, x-, y+, y-, radial"
    },
    "default": {
      "arc": 0.3,
      "spin": -20,
      "d": "pop",
      "o": "size",
      "ease": "inout"
    },
