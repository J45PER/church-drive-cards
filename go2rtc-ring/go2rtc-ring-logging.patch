 	if c.prod != nil {
 		_ = c.prod.Stop()
@@ -433,6 +437,26 @@ func (c *Client) Stop() error {
 	return nil
 }
 
+// callers names the functions that led to a Stop, so the log says who ended a stream.
+func callers() string {
+	pcs := make([]uintptr, 8)
+	n := runtime.Callers(3, pcs)
+	frames := runtime.CallersFrames(pcs[:n])
+	var names []string
+	for {
+		frame, more := frames.Next()
+		name := frame.Function
+		if i := strings.LastIndex(name, "/"); i >= 0 {
+			name = name[i+1:]
+		}
+		names = append(names, name)
+		if !more || len(names) >= 4 {
+			break
+		}
+	}
+	return strings.Join(names, " < ")
+}
+
 func (c *Client) MarshalJSON() ([]byte, error) {
