+// summarize describes a message for the debug log without anything secret:
+// the SDP and the ticket are left out, ICE candidates and notification text are kept.
+func summarize(msg WSMessage) string {
+	var parts []string
+	keys := make([]string, 0, len(msg.Body))
+	for k := range msg.Body {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		switch k {
+		case "doorbot_id", "session_id":
+			if v, ok := msg.Body[k].(string); ok && len(v) > 8 {
+				parts = append(parts, k+"="+v[:8]+"…")
+			} else {
+				parts = append(parts, fmt.Sprintf("%s=%v", k, msg.Body[k]))
+			}
+		case "sdp":
+			if v, ok := msg.Body[k].(string); ok {
+				parts = append(parts, fmt.Sprintf("sdp=%d bytes", len(v)))
+			}
+		case "ice", "text", "is_ok", "transcoding", "transcoding_reason", "mlineindex", "type":
+			parts = append(parts, fmt.Sprintf("%s=%v", k, msg.Body[k]))
+		default:
+			parts = append(parts, k)
+		}
+	}
+	return strings.Join(parts, " ")
+}
+
 func (c *WSClient) onWsMessage(msg WSMessage) {
+	Log.Debug().Str("method", msg.Method).Msgf("[ring] recv %s", summarize(msg))
+
 	if c.onMessage != nil {
 		c.onMessage(msg)
 	}
