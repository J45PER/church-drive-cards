diff --git a/pkg/ring/client_test.go b/pkg/ring/client_test.go
new file mode 100644
index 0000000..6a485e1
--- /dev/null
+++ b/pkg/ring/client_test.go
@@ -0,0 +1,73 @@
+package ring
+
+import (
+	"strings"
+	"testing"
+)
+
+func newTestClient() *Client {
+	return &Client{cameraID: 42, wsClient: &WSClient{}}
+}
+
+func msg(method string, body map[string]any) WSMessage {
+	return WSMessage{Method: method, Body: body}
+}
+
+func TestAcceptMessageAdoptsFirstSessionFromAnyMessage(t *testing.T) {
+	c := newTestClient()
+
+	// The answer arriving before session_created must not be dropped.
+	if !c.acceptMessage(msg("sdp", map[string]any{"doorbot_id": float64(42), "session_id": "abc", "sdp": "v=0"})) {
+		t.Fatal("answer with the first session id was dropped")
+	}
+	if c.wsClient.sessionID != "abc" {
+		t.Fatalf("session not adopted: %q", c.wsClient.sessionID)
+	}
+
+	// Same session still accepted, a different one is not.
+	if !c.acceptMessage(msg("ice", map[string]any{"doorbot_id": float64(42), "session_id": "abc"})) {
+		t.Fatal("message of the adopted session was dropped")
+	}
+	if c.acceptMessage(msg("ice", map[string]any{"doorbot_id": float64(42), "session_id": "other"})) {
+		t.Fatal("message of another session was accepted")
+	}
+}
+
+func TestAcceptMessageFiltersOtherCamerasAndBadTypes(t *testing.T) {
+	c := newTestClient()
+
+	if c.acceptMessage(msg("sdp", map[string]any{"doorbot_id": float64(7)})) {
+		t.Fatal("other camera accepted")
+	}
+	if c.acceptMessage(msg("sdp", map[string]any{})) {
+		t.Fatal("message without doorbot_id accepted")
+	}
+	if c.acceptMessage(msg("sdp", map[string]any{"doorbot_id": "42"})) {
+		t.Fatal("doorbot_id of the wrong type accepted")
+	}
+
+	// A session_id of the wrong type must not panic and is treated as no session.
+	if !c.acceptMessage(msg("notification", map[string]any{"doorbot_id": float64(42), "session_id": 5})) {
+		t.Fatal("message with a non-string session_id was dropped")
+	}
+	if c.wsClient.sessionID != "" {
+		t.Fatal("a bad session_id was adopted")
+	}
+}
+
+func TestSummarizeLeavesSecretsOut(t *testing.T) {
+	s := summarize(msg("sdp", map[string]any{
+		"doorbot_id": float64(42),
+		"session_id": "0123456789abcdef",
+		"sdp":        "v=0\r\na=ice-pwd:secret",
+		"token":      "should-not-appear",
+	}))
+	for _, bad := range []string{"secret", "should-not-appear", "0123456789abcdef"} {
+		if strings.Contains(s, bad) {
+			t.Fatalf("summary leaks %q: %s", bad, s)
+		}
+	}
+	if !strings.Contains(s, "sdp=") || !strings.Contains(s, "doorbot_id=42") {
+		t.Fatalf("summary missing fields: %s", s)
+	}
+}
